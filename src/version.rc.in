// Resource ID 1 is VS_VERSION_INFO; written as a number so no header is needed.
1 VERSIONINFO
 FILEVERSION @BT_VER_MAJOR@,@BT_VER_MINOR@,@BT_VER_PATCH@,0
 PRODUCTVERSION @BT_VER_MAJOR@,@BT_VER_MINOR@,@BT_VER_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "bngrw.dll replacement (@BT_GAME@)"
            VALUE "FileVersion", "@BT_VERSION@"
            VALUE "InternalName", "bngrw"
            VALUE "OriginalFilename", "bngrw.dll"
            VALUE "ProductName", "BanaTap"
            VALUE "ProductVersion", "@BT_VERSION@"
            VALUE "Comments", "Game revision @BT_GAME@, source revision @BT_REV@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
